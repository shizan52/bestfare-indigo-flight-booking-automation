# Copy to D:\vps\apps\indigo-bot\.env (deploy_box.py does this on first deploy). NEVER commit the real .env.

# Telegram bot token (from @BotFather)
BOT_TOKEN=123456:your-telegram-bot-token

# The ONLY admins: comma-separated Telegram user IDs. This is the single source of truth - the bot has no
# command that can create an admin, and every start-up re-syncs the database to exactly this list.
# Change it with:  python deploy_box.py --only-admins 111111111,222222222
ADMIN_IDS=

# Trusted, human-launched Edge/Chrome remote-debugging endpoint(s). One booking runs per endpoint at a
# time; add more browsers (comma separated) to scale: http://127.0.0.1:9222,http://127.0.0.1:9223
CDP_ENDPOINTS=http://127.0.0.1:9222

# Self-healing of the trusted Edge (doctor.py). EDGE_TASK is the Windows task made by
# `python deploy_box.py --setup-edge-task`; with EDGE_AUTOSTART=true the bot restarts a dead Edge through it.
EDGE_AUTOSTART=true
EDGE_TASK=BestFare-Edge

# Daily backup of the credit records (never contains passenger data), kept this many days in <base>\backups
BACKUP_KEEP=14

# Optional tuning
MAX_PAX=6
MAX_OPEN_JOBS_PER_USER=3
MAX_QUEUE=200
BOOKING_CLEANUP_HOURS=2
